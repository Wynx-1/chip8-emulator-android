<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHIP-8 BENCHMARK"
            android:textColor="#00FF41"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tests raw CPU execution speed"
            android:textColor="#555555"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Live counter — smaller so it never wraps -->
        <TextView
            android:id="@+id/tvLiveCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#00FF41"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:adjustViewBounds="true"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="cycles executed"
            android:textColor="#444444"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Status text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to benchmark"
            android:textColor="#888888"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00FF41"
            android:progressBackgroundTint="#1E2530"
            android:layout_marginBottom="20dp"/>

        <!-- Results card -->
        <LinearLayout
            android:id="@+id/resultsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161B22"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BENCHMARK RESULTS"
                android:textColor="#555555"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="14dp"/>

            <!-- Cycles per second -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cycles / second"
                    android:textColor="#888888"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvCyclesPerSec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#00FF41"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Total cycles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total cycles"
                    android:textColor="#888888"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvTotalCycles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#00FF41"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Estimated FPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estimated FPS"
                    android:textColor="#888888"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvEstFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#00FF41"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2530"
                android:layout_marginBottom="14dp"/>

            <!-- Rating badge -->
            <TextView
                android:id="@+id/tvRatingBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvRatingMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#888888"
                android:textSize="12sp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- RUN button -->
        <Button
            android:id="@+id/btnRunBenchmark"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:text="RUN BENCHMARK"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#161B22"
            android:textColor="#00FF41"/>

        <!-- BACK button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="BACK"
            android:textSize="12sp"
            android:backgroundTint="#0D1117"
            android:textColor="#555555"/>

    </LinearLayout>
</ScrollView>