<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161B22">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Speed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMULATION SPEED"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvSpeedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10 cycles/frame"
            android:textColor="#00FF41"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <SeekBar
            android:id="@+id/speedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="39"
            android:progress="9"
            android:progressTint="#00FF41"
            android:thumbTint="#00FF41"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="1x (slow)"
                android:textColor="#555555" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="40x (fast)"
                android:textColor="#555555" android:textSize="11sp" android:gravity="end"/>
        </LinearLayout>

        <!-- Theme -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COLOR THEME"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/themeRow1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button android:id="@+id/themeGreen"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="3dp"
                android:text="Green" android:textSize="11sp"
                android:backgroundTint="#002208" android:textColor="#00FF41"/>
            <Button android:id="@+id/themeAmber"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="3dp"
                android:text="Amber" android:textSize="11sp"
                android:backgroundTint="#1A1000" android:textColor="#FFB000"/>
            <Button android:id="@+id/themeBlue"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="3dp"
                android:text="Blue" android:textSize="11sp"
                android:backgroundTint="#000D1A" android:textColor="#00CFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button android:id="@+id/themeWhite"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="3dp"
                android:text="White" android:textSize="11sp"
                android:backgroundTint="#111111" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/themeRed"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="3dp"
                android:text="Red" android:textSize="11sp"
                android:backgroundTint="#1A0000" android:textColor="#FF3B3B"/>
            <Button android:id="@+id/themeMatrix"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="3dp"
                android:text="Matrix" android:textSize="11sp"
                android:backgroundTint="#001100" android:textColor="#AAFFAA"/>
        </LinearLayout>

        <!-- Visual Effects -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VISUAL EFFECTS"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"/>

        <!-- Glow toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pixel Glow"
                android:textColor="#CCCCCC" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGlow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#00FF41"
                android:trackTint="#1E2D1E"/>
        </LinearLayout>

        <!-- Scanlines toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CRT Scanlines"
                android:textColor="#CCCCCC" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchScanlines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="#00FF41"
                android:trackTint="#1E2D1E"/>
        </LinearLayout>

        <!-- Ghost frames -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FLICKER REDUCTION"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvGhostLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghost frames: 3"
            android:textColor="#00FF41"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <SeekBar
            android:id="@+id/ghostSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="3"
            android:progressTint="#00FF41"
            android:thumbTint="#00FF41"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Off (0)"
                android:textColor="#555555" android:textSize="11sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Max (5)"
                android:textColor="#555555" android:textSize="11sp" android:gravity="end"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>